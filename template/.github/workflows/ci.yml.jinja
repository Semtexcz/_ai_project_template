name: CI

on:
  pull_request:
  push:
    branches: [main]

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
{% if project_type in ["frontend", "fullstack"] %}
      - uses: pnpm/action-setup@v4
        with:
          version: 10
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
{% endif %}
      - name: Install uv
        uses: astral-sh/setup-uv@v6
      - name: Install dependencies
{% if project_type in ["frontend", "fullstack"] %}
        env:
          PNPM_INSTALL_FLAGS: --frozen-lockfile
{% endif %}
        run: make setup
      - name: Check
        run: make check
{% if project_type == "library" %}
      - name: Build distribution
        run: make build
{% if runtime_level == "shared" %}
      - name: Upload distribution artifacts
        uses: actions/upload-artifact@v4
        with:
          name: python-distribution
          path: dist/*
{% endif %}
{% elif project_type == "backend" %}
      - name: Build backend distribution
        run: make build
      - name: Smoke test backend runtime
        shell: bash
        run: |
          set -euo pipefail
          port="$(python - <<'PY'
          import socket

          with socket.socket() as sock:
              sock.bind(("127.0.0.1", 0))
              print(sock.getsockname()[1])
          PY
          )"
          setsid env HOST=127.0.0.1 PORT="${port}" make run > /tmp/backend.stdout 2> /tmp/backend.stderr &
          server_pid="$!"
          cleanup() {
              kill -- "-${server_pid}" 2>/dev/null || true
              wait "${server_pid}" 2>/dev/null || true
          }
          trap cleanup EXIT
          python - "${port}" <<'PY'
          import json
          import sys
          import time
          import urllib.error
          import urllib.request

          port = sys.argv[1]
          base_url = f"http://127.0.0.1:{port}"

          def get_json(path: str) -> dict:
              with urllib.request.urlopen(f"{base_url}{path}", timeout=2) as response:
                  if response.status != 200:
                      raise AssertionError(f"{path} returned {response.status}")
                  payload = json.loads(response.read().decode("utf-8"))
                  if not isinstance(payload, dict):
                      raise AssertionError(f"{path} did not return a JSON object")
                  return payload

          deadline = time.monotonic() + 20
          while True:
              try:
                  if get_json("/ready") == {"status": "ready"}:
                      break
              except (ConnectionError, TimeoutError, urllib.error.URLError):
                  if time.monotonic() >= deadline:
                      print("--- stdout ---")
                      print(open("/tmp/backend.stdout", encoding="utf-8").read())
                      print("--- stderr ---")
                      print(open("/tmp/backend.stderr", encoding="utf-8").read())
                      raise
                  time.sleep(0.25)

          assert get_json("/health") == {"status": "ok"}
          assert get_json("/ready") == {"status": "ready"}
          openapi = get_json("/openapi.json")
          assert openapi["info"]["title"]
          assert "/health" in openapi["paths"]
          assert "/ready" in openapi["paths"]
          PY
{% if runtime_level == "shared" %}
      - name: Upload backend distribution artifacts
        uses: actions/upload-artifact@v4
        with:
          name: backend-python-distribution
          path: backend/dist/*
{% endif %}
{% elif project_type == "frontend" %}
      - name: Build frontend application
        run: make build
      - name: Smoke test frontend runtime
        shell: bash
        run: |
          set -euo pipefail
          port="$(python - <<'PY'
          import socket

          with socket.socket() as sock:
              sock.bind(("127.0.0.1", 0))
              print(sock.getsockname()[1])
          PY
          )"
          setsid env HOST=127.0.0.1 PORT="${port}" make run > /tmp/frontend.stdout 2> /tmp/frontend.stderr &
          server_pid="$!"
          cleanup() {
              kill -- "-${server_pid}" 2>/dev/null || true
              wait "${server_pid}" 2>/dev/null || true
          }
          trap cleanup EXIT
          python - "${port}" <<'PY'
          import sys
          import time
          import urllib.error
          import urllib.request

          port = sys.argv[1]
          url = f"http://127.0.0.1:{port}/"
          deadline = time.monotonic() + 20
          last_error = None

          while time.monotonic() < deadline:
              try:
                  with urllib.request.urlopen(url, timeout=2) as response:
                      body = response.read().decode("utf-8")
                      assert response.status == 200
                      assert "text/html" in response.headers.get("content-type", "")
                      assert "{{ project_name }}" in body
                      assert "project/index.md" in body
                      break
              except (AssertionError, ConnectionError, TimeoutError, urllib.error.URLError) as exc:
                  last_error = exc
                  time.sleep(0.25)
          else:
              print("--- stdout ---")
              print(open("/tmp/frontend.stdout", encoding="utf-8").read())
              print("--- stderr ---")
              print(open("/tmp/frontend.stderr", encoding="utf-8").read())
              raise AssertionError(f"frontend did not become ready: {last_error!r}")
          PY
{% if runtime_level == "shared" %}
      - name: Upload frontend build artifact
        uses: actions/upload-artifact@v4
        with:
          name: frontend-nuxt-output
          path: frontend/.output
{% endif %}
{% elif project_type == "fullstack" %}
      - name: Build full-stack artifacts
        run: make build
{% if runtime_level == "production" %}
      - name: Install Playwright browser
        run: npx --yes playwright@1.62.1 install --with-deps chromium
      - name: Verify production image workflow
        run: |
          make image-build
          make prod-up
          make prod-smoke
          make e2e-production
          make prod-down
{% endif %}
{% endif %}

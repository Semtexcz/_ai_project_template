import { mount } from '@vue/test-utils'
import { describe, expect, it } from 'vitest'

import IndexPage from '../pages/index.vue'

describe('index page', () => {
  it('renders one semantic main region with the generated project content', () => {
{% if project_type == "fullstack" %}
    const wrapper = mount(IndexPage, {
      global: {
        stubs: {
          SystemInfoPanel: {
            template: '<section><h1>{{ project_name }}</h1><p>Open project/brief.md</p></section>'
          }
        }
      }
    })
{% else %}
    const wrapper = mount(IndexPage)
{% endif %}

    expect(wrapper.findAll('main')).toHaveLength(1)
    expect(wrapper.get('h1').text()).toBe('{{ project_name }}')
    expect(wrapper.text()).toContain('project/brief.md')
  })
})

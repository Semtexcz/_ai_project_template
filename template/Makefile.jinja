.PHONY: setup dev run test format-check lint typecheck api-schema api-generate api-check e2e e2e-production check build image-build image-inspect prod-up prod-status prod-smoke prod-down docs project-status sync-project-docs validate-project task-ready task-start task-review task-complete task-block task-unblock task-cancel task-approve agent-status agent-context validate-agent-skills agent-pre-task agent-pre-review agent-post-task agent-review-report down

PROJECT_TYPE := {{ project_type }}
RUNTIME_LEVEL := {{ runtime_level }}
PROJECT_SLUG := {{ project_slug }}
HOST ?= 127.0.0.1
PORT ?= 8000
PROD_BACKEND_PORT ?= 8000
PROD_FRONTEND_PORT ?= 3000
BACKEND_IMAGE ?= $(PROJECT_SLUG)-backend:production
FRONTEND_IMAGE ?= $(PROJECT_SLUG)-frontend:production
COMPOSE ?= docker compose
PNPM_INSTALL_FLAGS ?=
OPENAPI_SCHEMA ?= artifacts/openapi.json

setup:
{% if project_type in ["script", "library"] %}
	uv sync
{% elif project_type == "backend" %}
	cd backend && uv sync
{% elif project_type == "frontend" %}
	pnpm --dir frontend install $(PNPM_INSTALL_FLAGS)
{% else %}
	cd backend && uv sync
	pnpm --dir frontend install $(PNPM_INSTALL_FLAGS)
	$(MAKE) api-schema
	$(MAKE) api-generate
{% endif %}

dev:
{% if project_type in ["script", "library"] %}
	uv run python -m {{ python_package }}
{% elif project_type == "backend" %}
	cd backend && uv run uvicorn app.main:app --app-dir src --host $(HOST) --port $(PORT) --reload
{% elif project_type == "frontend" %}
	pnpm --dir frontend dev
{% else %}
	python tools/fullstack.py dev
{% endif %}

run:
{% if project_type in ["script", "library"] %}
	uv run python -m {{ python_package }}
{% elif project_type == "backend" %}
	cd backend && uv run uvicorn app.main:app --app-dir src --host $(HOST) --port $(PORT)
{% elif project_type == "frontend" %}
	cd frontend && HOST=$(HOST) PORT=$(PORT) node .output/server/index.mjs
{% else %}
	python tools/fullstack.py run
{% endif %}

test:
{% if project_type in ["script", "library"] %}
	uv run pytest
{% elif project_type == "backend" %}
	cd backend && uv run pytest
{% elif project_type == "frontend" %}
	pnpm --dir frontend test
{% else %}
	cd backend && uv run pytest
	pnpm --dir frontend test
{% endif %}

lint:
{% if project_type in ["script", "library"] %}
	uv run ruff check .
{% elif project_type == "backend" %}
	cd backend && uv run ruff check .
{% elif project_type == "frontend" %}
	pnpm --dir frontend lint
{% else %}
	cd backend && uv run ruff check .
	pnpm --dir frontend lint
{% endif %}

format-check:
{% if project_type in ["script", "library"] %}
	uv run ruff format --check .
{% elif project_type == "backend" %}
	cd backend && uv run ruff format --check .
{% elif project_type == "frontend" %}
	@true
{% else %}
	cd backend && uv run ruff format --check .
{% endif %}

typecheck:
{% if project_type in ["script", "library"] %}
	uv run pyright
{% elif project_type == "backend" %}
	cd backend && uv run pyright
{% elif project_type == "frontend" %}
	pnpm --dir frontend typecheck
{% else %}
	cd backend && uv run pyright
	pnpm --dir frontend typecheck
{% endif %}

api-schema:
{% if project_type == "fullstack" %}
	cd backend && uv run python -m app.export_openapi ../$(OPENAPI_SCHEMA)
{% else %}
	@true
{% endif %}

api-generate: api-schema
{% if project_type == "fullstack" %}
	python tools/api_client.py generate
{% else %}
	@true
{% endif %}

api-check: api-schema
{% if project_type == "fullstack" %}
	python tools/api_client.py check
{% else %}
	@true
{% endif %}

e2e:
{% if project_type == "fullstack" %}
	pnpm --dir frontend e2e
{% else %}
	@true
{% endif %}

e2e-production:
{% if project_type == "fullstack" and runtime_level == "production" %}
	E2E_BASE_URL=$${E2E_BASE_URL:-http://127.0.0.1:$(PROD_FRONTEND_PORT)} pnpm --dir frontend e2e
{% else %}
	@true
{% endif %}

{% if project_type == "fullstack" %}
check: sync-project-docs validate-project format-check lint typecheck api-check test
{% else %}
check: sync-project-docs validate-project format-check lint typecheck test
{% endif %}

build:
{% if project_type in ["script", "library"] %}
	rm -rf dist
	uv build
{% elif project_type == "backend" %}
	cd backend && uv build
{% elif project_type == "frontend" %}
	rm -rf frontend/.output
	pnpm --dir frontend build
{% else %}
	$(MAKE) api-check
	rm -rf backend/dist frontend/.output
	cd backend && uv build
	pnpm --dir frontend build
{% endif %}

image-build:
{% if project_type == "fullstack" and runtime_level == "production" %}
	$(COMPOSE) build
{% elif project_type == "backend" and runtime_level == "production" %}
	docker build -t $(BACKEND_IMAGE) backend
{% elif project_type == "frontend" and runtime_level == "production" %}
	docker build -t $(FRONTEND_IMAGE) frontend
{% else %}
	@true
{% endif %}

image-inspect:
{% if project_type == "fullstack" and runtime_level == "production" %}
	BACKEND_IMAGE=$(BACKEND_IMAGE) FRONTEND_IMAGE=$(FRONTEND_IMAGE) python tools/fullstack.py image-inspect
{% else %}
	@true
{% endif %}

prod-up:
{% if project_type == "fullstack" and runtime_level == "production" %}
	BACKEND_IMAGE=$(BACKEND_IMAGE) FRONTEND_IMAGE=$(FRONTEND_IMAGE) PROD_BACKEND_PORT=$(PROD_BACKEND_PORT) PROD_FRONTEND_PORT=$(PROD_FRONTEND_PORT) $(COMPOSE) up -d
{% else %}
	@true
{% endif %}

prod-status:
{% if project_type == "fullstack" and runtime_level == "production" %}
	BACKEND_IMAGE=$(BACKEND_IMAGE) FRONTEND_IMAGE=$(FRONTEND_IMAGE) PROD_BACKEND_PORT=$(PROD_BACKEND_PORT) PROD_FRONTEND_PORT=$(PROD_FRONTEND_PORT) COMPOSE='$(COMPOSE)' python tools/fullstack.py prod-status
{% else %}
	@true
{% endif %}

prod-smoke:
{% if project_type == "fullstack" and runtime_level == "production" %}
	PROD_BACKEND_URL=$${PROD_BACKEND_URL:-http://127.0.0.1:$(PROD_BACKEND_PORT)} PROD_FRONTEND_URL=$${PROD_FRONTEND_URL:-http://127.0.0.1:$(PROD_FRONTEND_PORT)} python tools/fullstack.py prod-smoke
{% else %}
	@true
{% endif %}

prod-down:
{% if project_type == "fullstack" and runtime_level == "production" %}
	BACKEND_IMAGE=$(BACKEND_IMAGE) FRONTEND_IMAGE=$(FRONTEND_IMAGE) PROD_BACKEND_PORT=$(PROD_BACKEND_PORT) PROD_FRONTEND_PORT=$(PROD_FRONTEND_PORT) $(COMPOSE) down --timeout 10
{% else %}
	@true
{% endif %}

docs:
	python tools/project.py status

project-status:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py status

sync-project-docs:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py sync

validate-project:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py validate

agent-status:
	PYTHONDONTWRITEBYTECODE=1 python tools/agent.py status

agent-context:
	PYTHONDONTWRITEBYTECODE=1 python tools/agent.py context --task $(TASK) $(if $(FORMAT),--format $(FORMAT),)

validate-agent-skills:
	PYTHONDONTWRITEBYTECODE=1 python tools/agent.py validate-skills

agent-pre-task:
	PYTHONDONTWRITEBYTECODE=1 python tools/agent.py pre-task --task $(TASK)

agent-pre-review:
	PYTHONDONTWRITEBYTECODE=1 python tools/agent.py pre-review --task $(TASK)

agent-post-task:
	PYTHONDONTWRITEBYTECODE=1 python tools/agent.py post-task --task $(TASK)

agent-review-report:
	PYTHONDONTWRITEBYTECODE=1 python tools/agent.py context --task $(TASK)

task-ready:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py ready $(TASK)

task-start:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py start $(TASK)

task-review:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py review $(TASK)

task-complete:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py complete $(TASK)

task-block:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py block $(TASK) --reason "$(REASON)" --unblock "$(UNBLOCK)"

task-unblock:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py unblock $(TASK)

task-cancel:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py cancel $(TASK)

task-approve:
	PYTHONDONTWRITEBYTECODE=1 python tools/project.py approve $(TASK) --approved-by "$(APPROVED_BY)"

down:
{% if project_type == "fullstack" and runtime_level == "production" %}
	$(MAKE) prod-down
{% elif project_type == "fullstack" %}
	@true
{% else %}
	@true
{% endif %}

schema_version: 1

project:
  name: "{{ project_name }}"
  slug: "{{ project_slug }}"
  type: "{{ project_type }}"
  runtime_level: "{{ runtime_level }}"
  governance: "{{ governance }}"
  workflow_mode: "{{ workflow_mode }}"
  risk: medium
  status: active

lifecycle:
  phase: definition
  milestone: M-01
  next_gate: ready-for-development

work:
  active_task: T-001
  blocked: false

template:
  version: "{{ _copier_conf.vcs_ref }}"

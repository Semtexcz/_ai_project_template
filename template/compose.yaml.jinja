services:
  backend:
    image: ${BACKEND_IMAGE:-{{ project_slug }}-backend:production}
    build:
      context: ./backend
      target: runtime
    ports:
      - "${PROD_BACKEND_PORT:-8000}:8000"
    environment:
      APP_ENVIRONMENT: production
      APP_CORS_ALLOWED_ORIGINS: '["http://127.0.0.1:${PROD_FRONTEND_PORT:-3000}","http://localhost:${PROD_FRONTEND_PORT:-3000}"]'
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=2)"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 5s
    stop_grace_period: 10s
  frontend:
    image: ${FRONTEND_IMAGE:-{{ project_slug }}-frontend:production}
    build:
      context: ./frontend
      target: runtime
      args:
        NUXT_PUBLIC_API_BASE_URL: ${NUXT_PUBLIC_API_BASE_URL:-http://127.0.0.1:${PROD_BACKEND_PORT:-8000}}
    ports:
      - "${PROD_FRONTEND_PORT:-3000}:3000"
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: 3000
      NUXT_PUBLIC_API_BASE_URL: ${NUXT_PUBLIC_API_BASE_URL:-http://127.0.0.1:${PROD_BACKEND_PORT:-8000}}
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 5s
    stop_grace_period: 10s

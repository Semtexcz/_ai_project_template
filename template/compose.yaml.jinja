services:
  backend:
    build:
      context: ./backend
    command: uv run fastapi dev src/app/main.py --host 0.0.0.0
    ports:
      - "8000:8000"
  frontend:
    image: node:22-alpine
    working_dir: /app
    command: sh -c "corepack enable && pnpm install && pnpm dev --host 0.0.0.0"
    ports:
      - "3000:3000"
    volumes:
      - ./frontend:/app
    environment:
      NUXT_PUBLIC_API_BASE: http://localhost:8000
